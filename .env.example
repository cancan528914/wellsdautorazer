# Javrex Bot System - örnek env. Gerçek değerleri .env dosyasına yazın.
DISCORD_TOKEN=buraya_bot_token
CLIENT_ID=buraya_client_id
GUILD_ID=buraya_guild_id
ADMIN_ROLE_ID=buraya_admin_rol_id
INGAME_ROLE_ID=
AKTIFLIK_ROLE_ID=
CLEAR_MIN=1
CLEAR_MAX=100
DM_DELAY_MS=200
DM_CONCURRENCY=5
# Sadece bu role sahip üyelere DM atılır (boşsa herkese)
DM_TARGET_ROLE_ID=
DM_MAX_TARGETS=0
MAX_MENTIONS_PER_FIELD=40
# Panel banner görselleri (opsiyonel, doğrudan görsel URL'si; boşsa gösterilmez)
INGAME_PANEL_IMAGE=
AKTIFLIK_PANEL_IMAGE=
DB_PATH=./data/wellsd.db
# --- Railway / PaaS notu ---
# Railway dosya sistemi GEÇİCİDİR: volume mount edilmezse her deploy'da
# veritabanı sıfırlanır (tickets, guard_whitelist, guard_settings, paneller).
# ÇÖZÜM: Railway dashboard → Service → Volumes → New Volume → Mount Path: /data
# Volume eklendiğinde RAILWAY_VOLUME_MOUNT_PATH otomatik gelir ve bot
# otomatik olarak /data/wellsd.db kullanır (DB_PATH gerekmez).
# Elle DB_PATH tanımlamak isterseniz: DB_PATH=/data/wellsd.db
# Discord REST isteklerinde HTTP/1.1 kullan (GoodbyeDPI/VPN/DPI arkası ağlarda gerekli). Kapatmak için false.
REST_HTTP1_ONLY=true
# Production süreleri (DPI'lı ağlarda handshake yavaş olabilir)
REST_TIMEOUT_MS=60000
REST_CONNECT_TIMEOUT_MS=30000
REST_RETRIES=3
REST_KEEPALIVE_MS=60000
HEARTBEAT_MS=40000
# --- Ticket sistemi ---
TICKET_STAFF_ROLE_ID=1522773972393922730
TICKET_CATEGORY_ID=buraya_ticket_kategori_id
TICKET_LOG_CHANNEL_ID=
TICKET_PANEL_CHANNEL_ID=
TICKET_LOG_ENABLED=true
TICKET_PANEL_IMAGE=
TICKET_MAX_OPEN_PER_USER=1
TICKET_CALL_COOLDOWN_MS=300000
# Yeni ticket açılışında etiketlenecek rol (boşsa ping atılmaz)
TICKET_PING_ROLE_ID=
# Açık ticketları salt-okunur görebilecek rol (boşsa ek izin verilmez)
TICKET_VIEWER_ROLE_ID=1522773972393922730
# Başvuru kabulünde verilen roller (virgüllü liste; boşsa varsayılan ikili kullanılır)
TICKET_ACCEPT_ROLE_IDS=1522773983588646982,1522773986721660928
# IC isim onay kanalı (bu kanala yazılan her mesaj için onay paneli açılır)
IC_APPROVAL_CHANNEL_ID=
# Mazeret bildirim bekleme süresi (ms)
MAZERET_COOLDOWN_MS=300000
# Mazeret bildirimlerinin düştüğü kanal (boşsa panelin kanalı kullanılır)
MAZERET_CHANNEL_ID=
# Mazeret panel banner görseli (/mazeretpng ile değişir)
MAZERET_PANEL_IMAGE=
# Yardım menüsü görseli (/komutlarpng ile değişir)
KOMUTLAR_IMAGE=
# Moderasyon log kanalı (ban/unban kayıtları; boşsa sadece console)
MOD_LOG_CHANNEL_ID=
# Yetki rol listeleri (virgüllü rol ID'leri; admin her kapıdan geçer)
ROLE_MANAGER_ROLE_IDS=
# Guard komut yetkisi kodda TEK ROLE kilitli (src/config.js → GUARD_MANAGER_ROLE_ID); bu değişken artık kullanılmıyor.
# Rolü değiştirmek için .env değil, src/config.js içindeki GUARD_MANAGER_ROLE_ID sabitini düzenleyin.
# GUARD_MANAGER_ROLE_IDS=
# --- Guard teşhis bayrakları (üretimde KAPALI bırakın) ---
# GUARD_DEBUG=true  → event akışı (rol/kanal oluş-sil-güncelle) SADECE terminale yazılır.
#                     Log kanalına ASLA spam atmaz. Sorun çözmek için açıp kapatın.
# LOG_DEBUG=true    → logger.debug() çıktıları (varsayılan: kapalı, spam yapmaz)
# Guard komutu kullanabilecek kişiler (rol verilemeyenler için istisna listesi, virgüllü).
# Boş bırakılırsa src/config.js → GUARD_MANAGER_USER_IDS_DEFAULT kullanılır.
# GUARD_MANAGER_USER_IDS=
BAN_MANAGER_ROLE_IDS=
STAFF_ROLE_IDS=
# Global komut erişimi: doluysa SADECE bu roller + adminler komut kullanabilir
BOT_ALLOWED_ROLE_IDS=
# Join log kanalı (sunucuya katılma — 1533266772633850027)
JOIN_LOG_CHANNEL_ID=1533266772633850027
# Quit log kanalı (sunucudan ayrılma)
QUIT_LOG_CHANNEL_ID=
# --- Transcript Web Server ---
WEB_ENABLED=true
WEB_PORT=3000
WEB_HOST=0.0.0.0
# Public transcript URL base (Railway/Production: https://your-app.up.railway.app)
WEB_URL=
WEB_TRUST_PROXY=1
